\ExplSyntaxOn
\prop_const_from_keyval:Nn \c__pt_tree_icons_prop
  {
    .zip=file-archive, .rar=file-archive, .tar=file-archive,
    .gz=file-archive, .7z=file-archive,
    .mp3=file-audio, .wav=file-audio, .ogg=file-audio,
    .c=file-code, .cpp=file-code, .h=file-code, .hpp=file-code,
    .java=file-code, .py=file-code, .js=file-code, .ts=file-code,
    .css=file-code, .html=file-code, .xml=file-code, .json=file-code,
    .sh=file-code, .rb=file-code, .php=file-code, .go=file-code,
    .rs=file-code, .tex=file-code,
    .xls=file-excel, .xlsx=file-excel,
    .doc=file-word, .docx=file-word,
    .ppt=file-powerpoint, .pptx=file-powerpoint,
    .jpg=file-image, .jpeg=file-image, .png=file-image,
    .gif=file-image, .svg=file-image,
    .pdf=file-pdf,
    .mp4=file-video, .avi=file-video, .mov=file-video, .mkv=file-video
  }
\str_new:N \l__pt_tree_input_str
\str_new:N \l__pt_tree_selector_str
\str_new:N \l__pt_tree_directory_str
\str_new:N \l__pt_tree_name_str
\str_new:N \l__pt_tree_extension_str
\tl_new:N \l__pt_tree_expanded_input_tl
\tl_new:N \l__pt_tree_icon_tl

\cs_new_protected:Npn \pt_tree_select_file_icon:
  {
    % A dotfile has an empty base name; never interpret its full name as a
    % known extension (for example, `.pdf' is still a generic file).
    \str_if_empty:NTF \l__pt_tree_name_str
      { \tl_set:Nn \l__pt_tree_icon_tl { file } }
      {
        \prop_get:NVNTF
          \c__pt_tree_icons_prop
          \l__pt_tree_extension_str
          \l__pt_tree_icon_tl
          { }
          { \tl_set:Nn \l__pt_tree_icon_tl { file } }
      }
  }

\cs_new_protected:Npn \pt_tree_select_auto_icon:
  {
    \str_if_empty:NTF \l__pt_tree_input_str
      { \tl_set:Nn \l__pt_tree_icon_tl { file } }
      {
        \str_case:VnF \l__pt_tree_input_str
          {
            {.}{\tl_set:Nn \l__pt_tree_icon_tl { folder-open }}
            {..}{\tl_set:Nn \l__pt_tree_icon_tl { folder-open }}
          }
          {
            \str_if_empty:NTF \l__pt_tree_extension_str
              {
                \str_if_empty:NTF \l__pt_tree_name_str
                  {
                    \str_if_empty:NTF \l__pt_tree_directory_str
                      { \tl_set:Nn \l__pt_tree_icon_tl { file } }
                      { \tl_set:Nn \l__pt_tree_icon_tl { folder-open } }
                  }
                  { \tl_set:Nn \l__pt_tree_icon_tl { folder-open } }
              }
              { \pt_tree_select_file_icon: }
          }
      }
  }

\cs_new_protected:Npn \pt_tree_select_icon:nn #1#2
  {
    \tl_set:Nx \l__pt_tree_expanded_input_tl {#2}
    \str_set:Nx \l__pt_tree_input_str
      { \tl_to_str:V \l__pt_tree_expanded_input_tl }
    \str_set:Nx \l__pt_tree_selector_str { \str_casefold:n {#1} }
    \file_parse_full_name:VNNN
      \l__pt_tree_input_str
      \l__pt_tree_directory_str
      \l__pt_tree_name_str
      \l__pt_tree_extension_str
    \str_set:Nx \l__pt_tree_extension_str
      { \str_casefold:V \l__pt_tree_extension_str }
    \str_case:VnF \l__pt_tree_selector_str
      {
        {auto}{\pt_tree_select_auto_icon:}
        {file}{\pt_tree_select_file_icon:}
        {folder}{\tl_set:Nn \l__pt_tree_icon_tl { folder-open }}
      }
      {
        \PackageWarningNoLine{pt-commons}
          {Unknown tree icon selector `#1'; using `auto'}
        \pt_tree_select_auto_icon:
      }
  }

\cs_new_protected:Npn \pt_tree_icon_box:n #1
  { \makebox[0.25cm][c]{\faIcon[regular]{#1}} }

\NewDocumentCommand{\treeicon}{O{auto}m}
  {
    \group_begin:
    \pt_tree_select_icon:nn {#1} {#2}
    \exp_args:NV \pt_tree_icon_box:n \l__pt_tree_icon_tl
    \tl_if_blank:nF {#2} {\ #2}
    \group_end:
  }

\NewDocumentCommand{\treeiconfirst}{O{auto}m}
  { \hspace{0.1cm}\treeicon[#1]{#2} }
\ExplSyntaxOff

