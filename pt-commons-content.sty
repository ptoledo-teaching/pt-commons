% Preserve the internal helper used by existing documents that load listings.
\newcommand{\pt@captionsetup@listing}[1]{%
    \@ifundefined{lstlisting}{}{%
        \@ifundefined{captionsetup}{}{\captionsetup[listing]{#1}}%
    }%
}

% Lists of contents %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifundefined{c@table}{}{\regtotcounter{table}}
\@ifundefined{c@figure}{}{\regtotcounter{figure}}

\newcommand{\ptlistoftables}{%
    \@ifundefined{c@table}{}{%
        \ifnum\totvalue{table}>0
            \listoftables
        \fi
    }%
}
\newcommand{\ptlistoffigures}{%
    \@ifundefined{c@figure}{}{%
        \ifnum\totvalue{figure}>0
            \listoffigures
        \fi
    }%
}
\newcommand{\ptlistofcodes}{%
    \@ifundefined{c@listing}{}{%
        \@ifundefined{listoflistings}{}{%
            \ifnum\totvalue{listing}>0\relax
                \listoflistings
            \fi
        }%
    }%
}

