        \IfFileExists{minted.sty}{%
            \RequirePackage[newfloat]{minted}%
        }{%
            \PackageWarningNoLine{pt-commons}{minted.sty not found; using the verbatim fallback}%
            \pt@usemintedfalse
        }%
    }%
\fi

