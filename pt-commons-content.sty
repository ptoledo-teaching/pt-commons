        bgcolor=ptgray!42,
        fontfamily=tt,
        fontsize=\small,
        autogobble=true,
        linenos=true,
        tabsize=4,
        numbersep=5pt,
        baselinestretch=0.75,
        showspaces=false,
        vspace=0.25cm
