% Code %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ifpt@useminted
    \@ifundefined{c@listing}{}{\regtotcounter{listing}}
    \setminted{%
        bgcolor=ptgray!42,
        fontfamily=tt,
        fontsize=\small,
        autogobble=true,
        linenos=true,
        tabsize=4,
        numbersep=5pt,
        baselinestretch=0.75,
        showspaces=false,
        vspace=0.25cm
    }
    \newenvironment{ptprintcode}[1]{%
        \VerbatimEnvironment
        \begin{minted}[%
            style=bw,
            bgcolor=white,
            frame=single
        ]{#1}%
    }{%
        \end{minted}%
    }
\else
    \newenvironment{ptprintcode}[1]{%
        \VerbatimEnvironment
        \Verbatim
    }{%
        \endVerbatim
    }
\fi

