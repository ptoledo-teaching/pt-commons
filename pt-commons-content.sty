\newcommand{\ptfigure}[5]{%
    % 1: Position (h, t, b, p)
    % 2: Options (width, height, scale, etc.)
    % 3: Image path
    % 4: Caption
    % 5: Label, with or without the fig: prefix
    \begin{figure}[#1]
        \centering
        \includegraphics[#2]{#3}
        \caption{#4}
        \IfBeginWith{#5}{fig:}{\label{#5}}{\label{fig:#5}}%
    \end{figure}%
}

% Tables %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Center tables in a local group so the declaration cannot affect later text.
\BeforeBeginEnvironment{tblr}{\begingroup\centering}
\AfterEndEnvironment{tblr}{\endgroup}
\SetTblrInner{rowsep=0.6pt}
\SetTblrInner{colsep=3pt}
\SetTblrInner{width=\columnwidth}

\ExplSyntaxOn
\cs_new_protected:Npn \pt_tblr_new_auto_width_column_type:nn #1 #2
{
    \exp_args:Nc \NewDocumentCommand { tblr_Column_type_ #1 } { g }
    {
        \bool_gset_false:N \g__tblr_colrow_spec_expand_stop_bool
        \IfNoValueTF {##1}
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[#2,t,co=1] } }
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[#2,t,wd=##1] } }
        \__tblr_expand_colrow_spec_next:N
    }
    \str_gput_right:Nn \gTblrUsedColumnTypeStr {#1}
}
\pt_tblr_new_auto_width_column_type:nn { L } { l }
\pt_tblr_new_auto_width_column_type:nn { C } { c }
\pt_tblr_new_auto_width_column_type:nn { R } { r }
\exp_args:Nc \RenewDocumentCommand { tblr_Column_type_ X } { o g }
{
    \bool_gset_false:N \g__tblr_colrow_spec_expand_stop_bool
    \IfNoValueTF {#2}
    {
        \IfNoValueTF {#1}
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[j,t,co=1] } }
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[j,t,co=1,#1] } }
    }
    {
        \IfNoValueTF {#1}
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[j,t,wd=#2] } }
        { \tl_gput_right:Nn \g__tblr_expanded_colrow_spec_tl { Q[j,t,#1,wd=#2] } }
    }
    \__tblr_expand_colrow_spec_next:N
}
\ExplSyntaxOff

