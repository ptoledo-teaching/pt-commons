\ProvidesPackage{pt-commons-layout}[2026/08/28 v0.2 PT Commons Layout]
\makeatletter

% Headers and footers %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifclassloaded{beamer}{}{%
    \RequirePackage{fancyhdr}
    \pagestyle{empty}
    % Center the footer on the physical page, not only on the text width.
    \newcommand{\pt@setfullpagefancyoffsets}{%
        \fancyhfoffset[LO]{\dimexpr1in+\oddsidemargin\relax}%
        \fancyhfoffset[RO]{\dimexpr\paperwidth-\textwidth-1in-\oddsidemargin\relax}%
        \if@twoside
            \fancyhfoffset[LE]{\dimexpr1in+\evensidemargin\relax}%
            \fancyhfoffset[RE]{\dimexpr\paperwidth-\textwidth-1in-\evensidemargin\relax}%
        \fi
    }
    \AtBeginDocument{\pt@setfullpagefancyoffsets}
    \renewcommand{\headrulewidth}{0pt}
    \lhead{}
    \chead{}
    \rhead{}
    \lfoot{}
    \cfoot{%
        \thepage%
        {%
            \color{ptblue!21}%
            \ifdefined\pt@version
                \ifdefempty{\pt@version}{}{\\v\pt@version}%
            \fi
            \ifdefined\pt@build
                \ifdefempty{\pt@build}{}{%
                    \ifdefined\pt@version
                        \ifdefempty{\pt@version}{\\B}{.}%
                    \else
                        \\B%
                    \fi
                    \ifdefstring{\pt@build}{auto}{\buildcount}{\pt@build}\ - \todayymd%
                }%
            \else
                \ifdefined\pt@version
                    \ifdefempty{\pt@version}{}{\ - \todayymd}%
                \fi
            \fi
        }%
    }
    \rfoot{}
}

% Footnotes %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ptfootnoterogue}[1]{%
    \begingroup
    \renewcommand\thefootnote{}%
    \footnotetext{#1}%
    \endgroup
}

% Sectioning %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifclassloaded{beamer}{}{%
    \RequirePackage{titlesec}
    \setlength{\parindent}{42pt}
    \titleformat{\section}
        {\normalfont\Large\bfseries}
        {\makebox[42pt][l]{\thesection.}}
        {0em}{}
    \titleformat{\subsection}
        {\normalfont\large\bfseries}
        {\makebox[42pt][l]{\thesubsection.}}
        {0em}{}
    \titleformat{\subsubsection}
        {\normalfont\normalsize\bfseries}
        {\makebox[42pt][l]{\thesubsubsection.}}
        {0em}{}
    \titleformat{\paragraph}[runin]
        {\normalfont\normalsize\bfseries}
        {\theparagraph}
        {0em}{}[.]
    \titleformat{\subparagraph}[runin]
        {\normalfont\normalsize\bfseries}
        {\thesubparagraph}
        {0em}{}[.]
}

% Lists %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifclassloaded{beamer}{}{%
    \RequirePackage{enumitem}
    \setlist[itemize,1]{%
        leftmargin=42pt,
        labelsep=6pt,
        topsep=6pt,
        parsep=0pt,
        itemsep=1pt
    }
    \setlist[itemize,2]{%
        leftmargin=12pt,
        topsep=0pt,
        parsep=0pt,
        itemsep=1pt
    }
    \setlist[enumerate,1]{%
        leftmargin=42pt,
        labelsep=6pt,
        topsep=6pt,
        parsep=0pt,
        itemsep=0pt
    }
    \setlist[enumerate,2]{%
        leftmargin=12pt,
        topsep=0pt,
        parsep=0pt,
        itemsep=0pt
    }
}

% Text styling %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ptinstruction}[1]{%
    \textcolor{ptred}{\textbf{\pt@labelinstruction} #1}%
}

% Bulleted list label styles
\def\labelitemi{$\scriptstyle\bullet$}
\def\labelitemii{$\scriptstyle\bullet$}
\def\labelitemiii{$\scriptstyle\bullet$}
\def\labelitemiv{$\scriptstyle\bullet$}
% Numbered list label styles
\def\labelenumi{\theenumi.}
\def\labelenumii{\theenumii.}
\def\labelenumiii{\theenumiii.}
\def\labelenumiv{\theenumiv.}
% Numbered list counter styles
\def\theenumi{\arabic{enumi}}
\def\theenumii{\arabic{enumii}}
\def\theenumiii{\arabic{enumiii}}
\def\theenumiv{\arabic{enumiv}}

\makeatother
\endinput
