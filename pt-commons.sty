\NeedsTeXFormat{LaTeX2e}[2023-06-01]
\ProvidesPackage{pt-commons}[2026/08/29 v0.4 PT Commons Package]
\makeatletter

% Package options %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newif\ifpt@useminted
\pt@usemintedtrue
\newif\ifpt@loadlayout
\newif\ifpt@loadcontent
\newif\ifpt@loadruntime
\pt@loadlayouttrue
\pt@loadcontenttrue
\pt@loadruntimetrue
\newcommand{\pt@language}{spanish}

\newcommand{\pt@coreonly}{%
    \pt@loadlayoutfalse
    \pt@loadcontentfalse
    \pt@loadruntimefalse
}
\newcommand{\pt@full}{%
    \pt@loadlayouttrue
    \pt@loadcontenttrue
    \pt@loadruntimetrue
}

\DeclareOption{spanish}{\renewcommand\pt@language{spanish}}
\DeclareOption{english}{\renewcommand\pt@language{english}}
\DeclareOption{portuguese}{\renewcommand\pt@language{portuguese}}
\DeclareOption{french}{\renewcommand\pt@language{french}}
\DeclareOption{nominted}{\pt@usemintedfalse}
\DeclareOption{coreonly}{\pt@coreonly}
\DeclareOption{minimal}{\pt@coreonly}
\DeclareOption{full}{\pt@full}
\DeclareOption{layout}{\pt@loadlayouttrue}
\DeclareOption{nolayout}{\pt@loadlayoutfalse}
\DeclareOption{content}{\pt@loadcontenttrue}
\DeclareOption{nocontent}{\pt@loadcontentfalse}
\DeclareOption{runtime}{\pt@loadruntimetrue}
\DeclareOption{noruntime}{\pt@loadruntimefalse}
% The starred form preserves the order written by the user. This is required
% for compositions such as [coreonly,content] and [full,noruntime].
\ProcessOptions*\relax

% Public module-state selectors for PT host classes.
% Close each primitive conditional before either caller-supplied branch is
% scanned. This lets branches safely contain their own \if...\else...\fi tokens.
\newcommand{\ptiflayoutloaded}{%
    \ifpt@loadlayout
        \expandafter\@firstoftwo
    \else
        \expandafter\@secondoftwo
    \fi
}
\newcommand{\ptifcontentloaded}{%
    \ifpt@loadcontent
        \expandafter\@firstoftwo
    \else
        \expandafter\@secondoftwo
    \fi
}
\newcommand{\ptifruntimeloaded}{%
    \ifpt@loadruntime
        \expandafter\@firstoftwo
    \else
        \expandafter\@secondoftwo
    \fi
}

\makeatother

% Core is mandatory. The remaining internal modules are enabled by default and
% can be disabled independently for lightweight or host-controlled documents.
\RequirePackage{pt-commons-core}
\makeatletter
\ifpt@loadlayout
    \RequirePackage{pt-commons-layout}
\fi
\ifpt@loadcontent
    \RequirePackage{pt-commons-content}
\fi
\ifpt@loadruntime
    \RequirePackage{pt-commons-runtime}
\else
    \AtBeginDocument{%
        \ifdefined\pt@build
            \ifdefstring{\pt@build}{auto}{%
                \PackageWarningNoLine{pt-commons}{%
                    Automatic build counting is disabled by the noruntime option%
                }%
            }{}%
        \fi
    }%
\fi
\makeatother

\endinput
