% Caption helpers are available with every supported class.
\newcommand{\ptcaption}[2]{\captionof{#1}{#2}}
\newcounter{ptcontinuedcaption}
\newcommand{\ptcaptionsame}[2]{%
    \@ifundefined{c@#1}{%
        \PackageError{pt-commons}{Unknown caption type `#1'}%
            {Define the `#1' counter before using \string\ptcaptionsame.}%
    }{%
        \ifnum\value{#1}>0
            \stepcounter{ptcontinuedcaption}%
            \begingroup
            % Reuse the printed counter while giving Hyperref a unique target.
            \@ifundefined{theH#1}{}{%
                \edef\pt@continued@anchor{%
                    \csname theH#1\endcsname.ptc\arabic{ptcontinuedcaption}%
                }%
                \expandafter\edef\csname theH#1\endcsname{\pt@continued@anchor}%
            }%
            \addtocounter{#1}{-1}%
            \captionof{#1}{#2}%
            \endgroup
        \else
            \PackageWarningNoLine{pt-commons}{%
                No previous `#1' caption; creating the first caption%
            }%
            \captionof{#1}{#2}%
        \fi
    }%
}

% Utility commands %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Spanish Babel makes < and > active to recognize <<...>>. A trailing active
% character needs a harmless look-ahead token before this command closes its
% local group.
\newcommand{\inlinecode}[1]{{\ttfamily\bfseries #1\relax}}
\newcommand{\twodigits}[1]{% Format a numeric expression using at least two digits.
    \ifnum\numexpr#1\relax<10 %
        0%
    \fi%
    \number\numexpr#1\relax%
}
\newcommand{\todayymd}{\the\year/\twodigits\month/\twodigits\day}

% Document metadata %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Metadata setters remain reusable so callers can override an earlier value.
\newcommand{\version}[1]{\gdef\pt@version{#1}}
\newcommand{\build}[1]{\gdef\pt@build{#1}}
\newcommand{\buildsources}[1]{\gdef\pt@buildsources{#1}}
\newcommand{\buildsource}[1]{%
    \ifdefined\pt@buildsources
        \gappto\pt@buildsources{,#1}%
    \else
        % The singular command adds to the default source set; only the plural
        % \buildsources command replaces it completely.
        \gdef\pt@buildsources{\jobname.tex,#1}%
    \fi
}
\providecommand{\buildcount}{0}
\newcommand{\docversion}{%
    \ifdefined\pt@version%
        \ifdefempty{\pt@version}{NA}{v\pt@version}%
    \else%
        NA%
    \fi%
}
\newcommand{\docschool}{%
    \ifdefined\pt@school%
        \ifdefempty{\pt@school}{NA}{\pt@school}%
    \else%
        NA%
    \fi%
}

% Preserve the native title/date behavior as well as the PT metadata used by
% the document classes. Optional short forms are forwarded when the host class
% supports them (for example Beamer and AMS classes).
\LetLtxMacro\pt@original@title\title
\LetLtxMacro\pt@original@date\date
\newcommand{\pt@title@regular}[1]{%
    \pt@original@title{#1}%
    \gdef\pt@title{#1}%
}
\long\def\pt@title@optional[#1]#2{%
    \pt@original@title[#1]{#2}%
    \gdef\pt@title{#2}%
}
\newcommand{\pt@date@regular}[1]{%
    \pt@original@date{#1}%
    \gdef\pt@date{#1}%
}
\long\def\pt@date@optional[#1]#2{%
    \pt@original@date[#1]{#2}%
    \gdef\pt@date{#2}%
}
\renewrobustcmd{\title}{\@ifnextchar[{\pt@title@optional}{\pt@title@regular}}
\renewrobustcmd{\date}{\@ifnextchar[{\pt@date@optional}{\pt@date@regular}}

% Document title
\newcommand{\titlesub}[1]{\gdef\pt@titlesub{#1}}
\newcommand{\titlesubsub}[1]{\gdef\pt@titlesubsub{#1}}
% Class information
\newcommand{\classcode}[1]{\gdef\pt@classcode{#1}}
\newcommand{\classsemester}[1]{\gdef\pt@classsemester{#1}}
\newcommand{\classname}[1]{\gdef\pt@classname{#1}}
% Institution information
\newcommand{\workgroup}[1]{\gdef\pt@workgroup{#1}}
\newcommand{\department}[1]{\gdef\pt@department{#1}}
\newcommand{\school}[1]{\gdef\pt@school{#1}}
\newcommand{\university}[1]{\gdef\pt@university{#1}}
% Corporate information
\newcommand{\corporation}[1]{\gdef\pt@corporation{#1}}
\newcommand{\corporationdepartment}[1]{\gdef\pt@corporationdepartment{#1}}

% Public metadata access for PT host classes. An explicit key registry prevents
% misspelled keys from exposing unrelated pt@ implementation macros.
\newcommand{\pt@declaremetadatakey}[1]{%
    \csdef{pt@metadata@key@#1}{}%
}
\forcsvlist{\pt@declaremetadatakey}{%
    version,build,buildsources,title,date,titlesub,titlesubsub,%
    classcode,classsemester,classname,workgroup,department,school,university,%
    corporation,corporationdepartment,background,backgroundcredit,logo,watermark%
}
\newcommand{\pt@invalidmetadatakey}[1]{%
    \PackageError{pt-commons}{Unknown metadata key `#1'}{%
        Use one of the metadata keys documented by PT Commons.}%
}
\newcommand{\ptmetadata}[1]{%
    \ifcsdef{pt@metadata@key@#1}{%
        \csuse{pt@#1}%
    }{%
        \pt@invalidmetadatakey{#1}%
    }%
}
\newcommand{\ptifmetadatadefined}[3]{%
    \ifcsdef{pt@metadata@key@#1}{%
        \ifcsundef{pt@#1}{#3}{#2}%
    }{%
        \pt@invalidmetadatakey{#1}#3%
    }%
}
\newcommand{\ptifmetadata}[3]{%
    \ifcsdef{pt@metadata@key@#1}{%
        \ifcsundef{pt@#1}{#3}{%
            \ifcsempty{pt@#1}{#3}{#2}%
        }%
    }{%
        \pt@invalidmetadatakey{#1}#3%
    }%
}

