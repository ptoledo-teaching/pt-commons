% Authors %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newlength{\lengthname}
\newlength{\lengthmail}
\newlength{\minipagelength}
\newcounter{authorindex}
\setcounter{authorindex}{0}

\newcommand\authornameentry[2]{#1, #2}
\newcommand\authoremailentry[1]{%
    \ifstrempty{#1}{}{\href{mailto:#1}{\nolinkurl{#1}}}%
}
\newcommand{\pt@author@tableemailrow}[1]{%
    \\% Complete the name/details row.
    \csname authoremailurl#1\endcsname &%
}
\newcommand{\pt@author@tablerow}[1]{%
    \csname authornamefull#1\endcsname
        & \csname authordetails#1\endcsname
    \csname authortableemailrow#1\endcsname
}

\newcommand\addauthor[4]{%
    \gdef\pt@authors{true}%
    \stepcounter{authorindex}%
    \expandafter\gdef\csname authornamelast\theauthorindex\endcsname{#2}%
    \expandafter\gdef\csname authornamefull\theauthorindex\endcsname{\authornameentry{#2}{#1}}%
    \expandafter\gdef\csname authoremailplain\theauthorindex\endcsname{#3}%
    \expandafter\gdef\csname authoremailurl\theauthorindex\endcsname{\authoremailentry{#3}}%
    \expandafter\gdef\csname authordetails\theauthorindex\endcsname{#4}%
    \ifstrempty{#3}{%
        \expandafter\gdef\csname authortableemailrow\theauthorindex\endcsname{}%
    }{%
        \expandafter\xdef\csname authortableemailrow\theauthorindex\endcsname{%
            \noexpand\pt@author@tableemailrow{\theauthorindex}%
        }%
    }%
    \settowidth{\lengthname}{#1, #2\textsuperscript{\alph{authorindex}}}%
    \ifstrempty{#3}{%
        \setlength{\lengthmail}{0pt}%
    }{%
        \settowidth{\lengthmail}{\nolinkurl{#3}}%
    }%
    \ifdim\lengthname>\minipagelength
        \setlength{\minipagelength}{\lengthname}%
    \fi
    \ifdim\lengthmail>\minipagelength
        \setlength{\minipagelength}{\lengthmail}%
    \fi
}

\newcommand{\titleauthorsnames}[1]{%
    \begingroup
    \count1=1%
    \loop
        \ifnum\count1<\numexpr\value{authorindex}+1\relax
        \ifnum\count1>1 #1\fi
        \csname authornamefull\the\count1\endcsname
        \advance\count1 by 1%
    \repeat
    \endgroup
}

\newcommand{\titleauthorsfooter}[1]{%
    \begingroup
    \count1=1%
    \loop
        \ifnum\count1<\numexpr\value{authorindex}+1\relax
        \ifnum\count1>1 #1\fi
        \csname authornamefull\the\count1\endcsname
        \expandafter\ifx\csname authoremailplain\the\count1\endcsname\@empty
        \else
            \ (\csname authoremailurl\the\count1\endcsname)%
        \fi
        \advance\count1 by 1%
    \repeat
    \endgroup
}

\newcommand{\titleauthorsboxes}{%
    \begingroup
    \addtolength{\minipagelength}{3pt}%
    \count1=1%
    \loop
        \ifnum\count1<\numexpr\value{authorindex}+1\relax
        \begin{minipage}{\minipagelength}
            \centering
            \csname authornamefull\the\count1\endcsname
            \if\relax\csname authordetails\the\count1\endcsname\relax
            \else
                \footnotemark[\the\count1]%
            \fi
            \expandafter\ifx\csname authoremailplain\the\count1\endcsname\@empty
            \else
                \\\csname authoremailurl\the\count1\endcsname
            \fi
        \end{minipage}%
        \advance\count1 by 1%
    \repeat
    \endgroup
}

\newcommand{\titleauthorsfootnotes}{%
    \begingroup
    \count1=1%
    \loop
        \ifnum\count1<\numexpr\value{authorindex}+1\relax
        \if\relax\csname authordetails\the\count1\endcsname\relax
        \else
            \footnotetext[\the\count1]{\csname authordetails\the\count1\endcsname}%
        \fi
        \advance\count1 by 1%
    \repeat
    \endgroup
}

\ExplSyntaxOn
\newcommand{\titleauthorstable}{%
    \begingroup
    \ifnum\value{authorindex}>0
        \begin{tabular}{r|l}
        \int_step_inline:nn { \value{authorindex} }
            { \pt@author@tablerow{##1} \\ }
        \end{tabular}%
    \fi
    \endgroup
}
\ExplSyntaxOff

