% Links %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifpackageloaded{hyperref}{}{\RequirePackage[colorlinks]{hyperref}}
\renewcommand{\UrlFont}{\normalfont}
\LetLtxMacro\hrefregular\href
\newcommand{\pt@href@regular}[2]{%
    \hrefregular{#1}{\color{ptlightblue}\textbf{#2}}%
}
\def\pt@href@optional[#1]#2#3{%
    \hrefregular[#1]{#2}{\color{ptlightblue}\textbf{#3}}%
}
\renewrobustcmd{\href}{\@ifnextchar[{\pt@href@optional}{\pt@href@regular}}
\newcommand{\pt@ref@regular}[1]{\textbf{\refregular{#1}}}
\newcommand{\pt@ref@star}[1]{\textbf{\refregular*{#1}}}
\newcommand{\pt@autoref@regular}[1]{\textbf{\autorefregular{#1}}}
\newcommand{\pt@autoref@star}[1]{\textbf{\autorefregular*{#1}}}
\AtBeginDocument{%
    \LetLtxMacro\refregular\ref
    \renewrobustcmd{\ref}{\@ifstar\pt@ref@star\pt@ref@regular}%
    \LetLtxMacro\autorefregular\autoref
    \renewrobustcmd{\autoref}{\@ifstar\pt@autoref@star\pt@autoref@regular}%
}

% Semantic text helpers belong to core and remain available in core-only mode.
\newcommand{\ptinstruction}[1]{%
    \textcolor{ptred}{\textbf{\pt@labelinstruction} #1}%
}
\newcommand{\ptfootnoterogue}[1]{%
    \begingroup
    \renewcommand\thefootnote{}%
    \footnotetext{#1}%
    \endgroup
}

% Language %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Avoid an option clash when the host document loaded Babel first. If the
% requested language is not available yet, use Babel's public locale loader.
\@ifpackageloaded{babel}{%
    \@ifundefined{captions\pt@language}{%
        \@ifundefined{babelprovide}{%
            \PackageError{pt-commons}{Language `\pt@language' is not loaded}%
                {Load Babel with `\pt@language' before PT Commons.}%
        }{%
            \babelprovide[import]{\pt@language}%
        }%
    }{}%
    \AtBeginDocument{\selectlanguage{\pt@language}}%
}{%
    \RequirePackage[\pt@language]{babel}%
}

