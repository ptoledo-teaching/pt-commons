% Links %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\@ifpackageloaded{hyperref}{}{\RequirePackage[colorlinks]{hyperref}}
\renewcommand{\UrlFont}{\normalfont}
\LetLtxMacro\hrefregular\href
\newcommand{\pt@href@regular}[2]{%
    \hrefregular{#1}{\color{ptlightblue}\textbf{#2}}%
}
\def\pt@href@optional[#1]#2#3{%
    \hrefregular[#1]{#2}{\color{ptlightblue}\textbf{#3}}%
}
\renewrobustcmd{\href}{\@ifnextchar[{\pt@href@optional}{\pt@href@regular}}
\newcommand{\pt@ref@regular}[1]{\textbf{\refregular{#1}}}
\newcommand{\pt@ref@star}[1]{\textbf{\refregular*{#1}}}
